{
    "name": "oigonzalezp2024/scaffold-engine-cli-php",
    "description": "A clean-architecture PHP engine for dynamic file scaffolding, template replacement, and module provisioning.",
    "type": "project",
    "license": "MIT",
    "keywords": [
        "scaffolding",
        "clean-architecture",
        "template-replacer",
        "generator",
        "cli",
        "provisioning"
    ],
    "authors": [
        {
            "name": "Óscar Iván González Peña",
            "role": "Lead Developer"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-json": "*",
        "oigonzalezp2024/scaffold-engine-php": "^1.0.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "App\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/console.php"
    ],
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/oigonzalezp2024/scaffold-engine-php"
        }
    ],
    "minimum-stability": "stable",
    "prefer-stable": true
}
